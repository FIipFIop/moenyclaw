# ─── AI (required for agent reasoning) ──────────────────────────────────────
OPENROUTER_API_KEY=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              # get free at openrouter.ai — agents run in demo mode without this

# ─── Polymarket (optional) ───────────────────────────────────────────────────
# Leave blank to skip — agents will run in demo/paper mode
POLYMARKET_API_KEY=
POLYMARKET_PRIVATE_KEY=          # wallet private key for EIP-712 order signing
POLYMARKET_PROXY_ADDRESS=        # optional: proxy wallet address

# ─── Hyperliquid (optional) ──────────────────────────────────────────────────
# Leave blank to skip — agents will run in demo/paper mode
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_ADDRESS=
HYPERLIQUID_NETWORK=mainnet      # mainnet or testnet

# ─── Telegram (optional) ─────────────────────────────────────────────────────
# Leave blank — system runs fine without it (use dashboard directly)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=        # your numeric Telegram user ID (find via @userinfobot)

# ─── App ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./moneyclaw.sqlite
BACKEND_URL=http://localhost:8000
DASHBOARD_URL=192.168.0.125:3000 # local network URL used in /web Telegram command
SECRET_KEY=                      # generate: python -c "import secrets; print(secrets.token_hex(32))"
TRADING_ENABLED=false            # set true to allow real order execution
LOG_LEVEL=INFO
